{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Barklarm",
  "version": "4.0.1",
  "identifier": "dev.barklarm.app",
  "build": {
    "frontendDist": "../dist/mainview",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "bun run dev:renderer",
    "beforeBuildCommand": "bun run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Barklarm",
        "width": 860,
        "height": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false,
        "devtools": false
      },
      {
        "label": "tray",
        "title": "Barklarm",
        "url": "index.html?window=tray",
        "width": 380,
        "height": 520,
        "visible": false,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": false,
        "shadow": true,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/llama-server"
    ],
    "resources": [
      "binaries/llama-libs/*"
    ]
  }
}
