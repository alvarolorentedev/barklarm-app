{
  "name": "barklarm",
  "productName": "Barklarm",
  "version": "4.0.0",
  "description": "Build & Observability Radiator",
  "repository": "https://github.com/alvarolorentedev/barklarm-app",
  "contributors": [
    {
      "name": "alvaro",
      "email": "contact@alvarolorente.dev",
      "url": "https://github.com/alvarolorentedev"
    }
  ],
  "scripts": {
    "dev": "tauri dev",
    "dev:mock": "vite --config vite.config.ts --mode mock",
    "dev:renderer": "vite --config vite.config.ts",
    "build": "tauri build",
    "build:renderer": "vite build --config vite.config.ts",
    "tauri": "tauri",
    "test": "vitest run .",
    "test:cov": "vitest run --coverage",
    "test:dev": "vitest watch",
    "test:e2e": "playwright test",
    "check": "bun run format:check && bun run lint:check && bun run tsc:check && bun run test:cov && bun run build:renderer && bun run check:mock-isolation && bun run test:evals:mock",
    "check:mock-isolation": "bun scripts/check-mock-isolation.mjs",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "audit": "bun audit --production --audit-level=high",
    "tsc:check": "tsc --noEmit --skipLibCheck",
    "lint:check": "eslint src e2e playwright.config.ts --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src e2e playwright.config.ts --ext .ts,.tsx --fix",
    "format:fix": "prettier --write src e2e playwright.config.ts scripts",
    "format:check": "prettier --check src e2e playwright.config.ts scripts",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "commit": "git add . && cz",
    "sidecar:fetch": "bun scripts/fetch-llama.ts",
    "test:evals:mock": "bun scripts/evals/run.ts --mode=mock",
    "test:evals:local": "bun scripts/evals/run.ts --mode=local",
    "sidecar:smoke": "bun scripts/smoke-sidecar.ts",
    "sidecar:smoke:runtime": "bun scripts/smoke-managed-runtime.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "8.4.1",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "16.0.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "commitizen": "4.3.0",
    "cz-conventional-changelog": "3.3.0",
    "cz-format-extension": "1.5.1",
    "eslint": "^8.0.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.25.0",
    "husky": "9.1.4",
    "jsdom": "^26.1.0",
    "lint-staged": "15.2.8",
    "prettier": "3.3.3",
    "typescript": "~4.5.4",
    "vite": "^5.4.21",
    "vitest": "^3.2.6"
  },
  "keywords": [],
  "author": {
    "name": "alvaro lorente",
    "email": "contact@alvarolorente.dev"
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "cz-format-extension"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "fast-xml-parser": "^4.5.5",
    "lucide-react": "^1.73.0",
    "react": "18.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.20.0",
    "@rollup/rollup-win32-x64-msvc": "4.20.0"
  },
  "packageManager": "bun@1.4.5",
  "overrides": {
    "ws": "^8.21.0"
  }
}
