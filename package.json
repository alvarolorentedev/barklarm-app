{
  "name": "barklarm",
  "productName": "Barklarm",
  "version": "3.0.0",
  "description": "Build & Observability Radiator",
  "repository": "https://github.com/alvarolorentedev/barklarm-app",
  "contributors": [
    {
      "name": "alvaro",
      "email": "contact@alvarolorente.dev",
      "url": "https://github.com/alvarolorentedev"
    }
  ],
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --config vite.config.ts",
    "build": "tauri build",
    "build:renderer": "vite build --config vite.config.ts",
    "tauri": "tauri",
    "test": "vitest run .",
    "test:cov": "vitest run --coverage",
    "test:dev": "vitest watch",
    "tsc:check": "tsc --noEmit --skipLibCheck",
    "lint:check": "eslint src --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format:fix": "prettier --write src",
    "format:check": "prettier --check src",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "commit": "git add . && cz"
  },
  "devDependencies": {
    "@faker-js/faker": "8.4.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "16.0.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "commitizen": "4.3.0",
    "cz-conventional-changelog": "3.3.0",
    "cz-format-extension": "1.5.1",
    "eslint": "^8.0.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.25.0",
    "husky": "9.1.4",
    "jsdom": "^24.1.1",
    "lint-staged": "15.2.8",
    "prettier": "3.3.3",
    "typescript": "~4.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "keywords": [],
  "author": {
    "name": "alvaro lorente",
    "email": "contact@alvarolorente.dev"
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "cz-format-extension"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "fast-xml-parser": "4.4.1",
    "lucide-react": "^1.73.0",
    "react": "18.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.20.0",
    "@rollup/rollup-win32-x64-msvc": "4.20.0"
  }
}
