{
  "name": "barklarm",
  "productName": "Barklarm",
  "version": "3.0.0",
  "description": "Build & Observability Radiator",
  "main": "src/bun/index.ts",
  "repository": "https://github.com/alvarolorentedev/barklarm-app",
  "contributors": [
    {
      "name": "alvaro",
      "email": "contact@alvarolorente.dev",
      "url": "https://github.com/alvarolorentedev"
    }
  ],
  "scripts": {
    "test": "vitest run .",
    "test:cov": "vitest run --coverage",
    "test:dev": "vitest watch",
    "dev": "bun run build:renderer && PATH=\"$HOME/.hutch/npm/electrobun/2.0.1/macos-arm64/bin:$PATH\" hutch run dev",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "bun run build:renderer && PATH=\"$HOME/.hutch/npm/electrobun/2.0.1/macos-arm64/bin:$PATH\" hutch electrobun build",
    "build:mac": "bun run build:renderer && PATH=\"$HOME/.hutch/npm/electrobun/2.0.1/macos-arm64/bin:$PATH\" hutch electrobun build --platform darwin",
    "build:linux": "bun run build:renderer && PATH=\"$HOME/.hutch/npm/electrobun/2.0.1/macos-arm64/bin:$PATH\" hutch electrobun build --platform linux",
    "build:win": "bun run build:renderer && PATH=\"$HOME/.hutch/npm/electrobun/2.0.1/macos-arm64/bin:$PATH\" hutch electrobun build --platform win32",
    "tsc:check": "tsc --noEmit --skipLibCheck",
    "lint:check": "eslint src --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format:fix": "prettier --write src",
    "format:check": "prettier --check src",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "commit": "git add . && cz"
  },
  "devDependencies": {
    "@datadog/datadog-api-client": "1.26.0",
    "@emotion/react": "11.13.0",
    "@emotion/styled": "11.13.0",
    "@faker-js/faker": "8.4.1",
    "@mui/icons-material": "5.16.6",
    "@mui/material": "5.16.6",
    "@mui/x-date-pickers": "7.12.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "16.0.0",
    "@types/luxon": "3.4.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "commitizen": "4.3.0",
    "cz-conventional-changelog": "3.3.0",
    "cz-format-extension": "1.5.1",
    "eslint": "^8.0.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.25.0",
    "fast-xml-parser": "4.4.1",
    "husky": "9.1.4",
    "lint-staged": "15.2.8",
    "luxon": "3.5.0",
    "octokit": "3.1.0",
    "prettier": "3.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.0",
    "typescript": "~4.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "keywords": [],
  "author": {
    "name": "alvaro lorente",
    "email": "contact@alvarolorente.dev"
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "cz-format-extension"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "azure-devops-node-api": "^14.0.2",
    "electrobun": "^2.0.1",
    "jsdom": "^24.1.1",
    "opsgenie-sdk": "^0.5.1",
    "request": "^2.88.2",
    "vite-plugin-static-copy": "^1.0.6"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.20.0",
    "@rollup/rollup-win32-x64-msvc": "4.20.0"
  }
}
